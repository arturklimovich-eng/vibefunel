# Copy to apps/web/.env.local. Never commit real values. Never prefix secrets with NEXT_PUBLIC_.

# Storage backend: "file" (local JSON under .data/, no auth) or "supabase".
# When unset: "supabase" if both Supabase variables below are set, otherwise "file".
FUNNEL_STORAGE=file

# Supabase. Read on the server only (nothing in the browser talks to Supabase), so these are runtime variables and work in a prebuilt Docker image.
# The anon key is public by design; safe only because RLS is enforced. NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are still accepted as fallbacks but are compiled into the build.
# Local: run `pnpm supabase:start` and use the API URL and the anon key it prints
# (`pnpm supabase:status -o env` shows API_URL and ANON_KEY).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server only. Used by the payment webhook and payment-status paths (lib/supabase/service.ts) to call record_payment_event, get_payment_status and look up a funnel project. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Payments. Provider: "stripe" (default) or "solidgate" (not implemented: always reports not_configured).
PAYMENT_PROVIDER=stripe

# Public origin used to build payment return URLs. REQUIRED in production (startup check); falls back to the request origin in development.
APP_URL=http://localhost:3000

# Server-only secret (16+ chars) used to HMAC-bind a payment run to the browser that started it. Required for any provider to be ready.
RUN_TOKEN_SECRET=

# Number of trusted reverse proxies in front of the app. 0 (default): X-Forwarded-For is ignored and all clients share one rate-limit bucket.
TRUST_PROXY_HOPS=0

# Stripe test mode. The secret key and webhook secret are server only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public by design (inlined into the client bundle); must belong to the same Stripe account as the secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-side plan catalogue (one-time payments only; recurring prices are rejected). The client sends only a planKey; amount (minor units) and currency come from here.
# Add stripePriceId to charge an existing Stripe Price; its amount must equal the catalogue amount or the payment is rejected.
PAYMENT_PLANS_JSON={"starter_onetime":{"title":"Starter (one-time)","amount":1900,"currency":"usd"}}

# Solidgate: not implemented (see docs/IMPLEMENTATION_PLAN.md, open questions). Unused.
SOLIDGATE_MERCHANT_ID=
SOLIDGATE_SECRET=

# Development only: simulated payments through /api/payments/mock/*. Ignored when NODE_ENV=production.
PAYMENTS_MOCK=false

# Analytics (PostHog). Leave the public key empty to disable analytics entirely (no banner, no SDK).
# Public by design (inlined into the client bundle at build time). The browser SDK starts only after the visitor accepts the consent banner on /f/<slug>.
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com (default) or https://eu.i.posthog.com for EU data residency.
NEXT_PUBLIC_POSTHOG_HOST=
# Server-side capture (payment_succeeded and payment_failed from verified webhooks). Falls back to the NEXT_PUBLIC_ values when empty.
POSTHOG_KEY=
POSTHOG_HOST=
# "true" sends the selected option ids with answer_selected. Default: only the number of selected options is sent.
NEXT_PUBLIC_ANALYTICS_ANSWER_IDS=false

# Custom domains for funnels. Visitors' browsers must reach this host (CNAME target shown in the studio);
# defaults to the APP_URL host. CUSTOM_DOMAIN_TARGET_IP is shown for apex domains that need an A record.
CUSTOM_DOMAIN_TARGET=
CUSTOM_DOMAIN_TARGET_IP=
# Optional comma-separated DNS servers (host or host:port) used for ownership checks instead of the system resolver.
CUSTOM_DOMAIN_DNS_SERVERS=
# Optional shared secret for the proxy's on-demand TLS "ask" requests (see docs/DEPLOYMENT.md).
CUSTOM_DOMAIN_ASK_SECRET=
# Optional comma-separated extra hostnames that serve the platform itself (www., Coolify-generated URL).
PLATFORM_HOSTS=
# Optional header carrying the client IP from the outermost proxy (cf-connecting-ip behind Cloudflare); used only when TRUST_PROXY_HOPS > 0.
CLIENT_IP_HEADER=
# Bearer token for the scheduled endpoints POST /api/cron/domains (custom-domain re-verification) and POST /api/cron/payments (stale refund/dispute report). 16+ characters.
CRON_SECRET=
